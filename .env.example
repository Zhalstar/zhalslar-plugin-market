DOMAIN=plugins.example.com
PUBLIC_URL=https://plugins.example.com
FRONTEND_URL=https://plugins.example.com
APP_ENV=production
DATABASE_URL=postgresql+psycopg://market:replace-me@db:5432/market
POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=replace-me
AUTH_SECRET_KEY=replace-with-a-long-random-string
SECURE_COOKIES=true
OAUTH_ENCRYPTION_KEY=replace-with-a-fernet-key
GITHUB_ENABLED=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://plugins.example.com/api/v1/oauth/github/callback
GITEE_ENABLED=true
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
GITEE_CALLBACK_URL=https://plugins.example.com/api/v1/oauth/gitee/callback
